# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# Devin API key (Devin settings -> API keys).
DEVIN_API_KEY=

# Shared secret configured on the GitHub webhook; used to verify signatures.
GITHUB_WEBHOOK_SECRET=

# Optional overrides.
DEVIN_API_URL=https://api.devin.ai/v1
TRIGGER_LABEL=devin
