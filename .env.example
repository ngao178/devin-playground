# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# Devin API key (Devin settings -> API keys). Must be an org-scoped key with the
# ManageOrgSessions permission (used against the v3 API).
DEVIN_API_KEY=

# Devin organization ID (prefix: org-). Sessions are created under this org via
# POST /v3/organizations/{DEVIN_ORG_ID}/sessions.
DEVIN_ORG_ID=

# Shared secret configured on the GitHub webhook; used to verify signatures.
GITHUB_WEBHOOK_SECRET=

# Optional overrides.
DEVIN_API_URL=https://api.devin.ai/v3
TRIGGER_LABEL=devin

# ngrok auth token (https://dashboard.ngrok.com/get-started/your-authtoken).
# Only needed when using the `ngrok` service in docker-compose.yml to expose
# the webhook publicly.
NGROK_AUTHTOKEN=
