# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# Devin service user API key, `cog_` prefix (Devin settings -> Service users).
# The role needs ManageOrgSessions and ViewOrgSessions.
DEVIN_API_KEY=

# Organization the sessions are created in, `org-` prefix.
DEVIN_ORG_ID=

# Shared secret configured on the GitHub webhook; used to verify signatures.
GITHUB_WEBHOOK_SECRET=

# Comma-separated owner/repo allowlist; empty means every repo that reaches
# this endpoint can start a session.
ALLOWED_REPOS=ngao178/superset

# Optional overrides.
DEVIN_API_URL=https://api.devin.ai
TRIGGER_LABEL=devin

# --- Dependency bump scanner (independent of the webhook flow) ---

# Set to false to turn the periodic scanner off.
DEP_SCAN_ENABLED=true

# How often the scanner diffs the watched repos, in seconds (2.5 minutes).
DEP_SCAN_INTERVAL_SECONDS=150

# Comma-separated owner/repo list to scan; defaults to ALLOWED_REPOS.
DEP_SCAN_REPOS=ngao178/superset

# Run `npm audit --json` / `pip-audit` on the flagged commit and feed the
# vulnerabilities into the bump prompt. Needs git, npm, and pip-audit on PATH.
DEP_AUDIT_ENABLED=true
DEP_AUDIT_TIMEOUT_SECONDS=300

# GitHub token used to read commits/diffs (public repos work unauthenticated,
# but rate limits are much lower). Needs `repo` read access.
GITHUB_TOKEN=

# ngrok auth token (https://dashboard.ngrok.com/get-started/your-authtoken).
# Only needed when using the `ngrok` service in docker-compose.yml to expose
# the webhook publicly.
NGROK_AUTHTOKEN=
